# RPC endpoints
MAINNET_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"
LOCAL_URL="http://127.0.0.1:8545"

# Deployer: this repo uses Foundry keystore accounts (cast wallet), not raw private keys.
# Import once:   cast wallet import deployer --interactive
# Then deploy:   script/deploy.sh --network mainnet --account deployer
# (No PRIVATE_KEY in .env.)

# Verification: Etherscan API V2 uses ONE key for all chains.
ETHERSCAN_API_KEY=""

# Deploy constructor args live in deployments/deploy-config.json
# (copy from deployments/deploy-config.example.json).
